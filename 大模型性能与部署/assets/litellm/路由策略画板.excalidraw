    {
      "id": "7nh5GYBr7tN1iWSzbLFpA",
      "type": "text",
      "x": 3287.55432673863,
      "y": 1158.6018240792412,
      "width": 501.89996337890625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
